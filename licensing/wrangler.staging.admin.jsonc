{
  "name": "sv-admin-v2-staging",
  "main": "admin-api/worker.mjs",
  "compatibility_date": "2026-04-21",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spectravision-licenses-staging",
      "database_id": "fdcc61bb-93d9-4a5e-a842-d15fc88e4bf4"
    }
  ],
  "keep_vars": true,
  "assets": {
    "directory": "./dashboard/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
