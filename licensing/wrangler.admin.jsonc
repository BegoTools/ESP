{
  "name": "sv-admin-v2",
  "main": "admin-api/worker.mjs",
  "compatibility_date": "2026-04-21",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spectravision-licenses",
      "database_id": "6b885a7d-5470-4bcc-864b-75c9198aca8c"
    }
  ],
  "keep_vars": true,
  "assets": {
    "directory": "./dashboard/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
